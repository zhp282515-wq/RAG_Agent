# ---- 敏感配置 ----
.env
.env.*
!.env.example

# ---- 虚拟环境 / 构建产物 ----
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# ---- 前端(Vue 源码入库,依赖与构建产物不入库) ----
# 前端整份构建产物都不入库:web/static/ 完全由 vite build 生成
# (index.html 里引用的是带 hash 的资源名,与 assets/ 必须同进同出,否则会 404)。
# 部署前须先 `cd frontend && npm run build`。
frontend/node_modules/
frontend/dist/
web/static/

# ---- 本地工具配置(含本机绝对路径) ----
.claude/

# ---- IDE / 系统 ----
.idea/
.vscode/
*.swp
Thumbs.db
.DS_Store

# ---- 运行时数据:上传文件、用户数据、向量库卷、日志 ----
data/uploads/
data/external/
data/
volumes/
logs/
attu
